---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="News and tournament reports from Team Tennent's.">
  <h1>Blog</h1>
  <p class="lede">News, tournament reports and the occasional excuse.</p>

  <ul class="posts">
    {posts.map((post) => (
      <li class="panel">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <h2><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.summary}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .posts li {
    padding: 1.25rem 1.4rem;
  }
  .posts time {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .posts h2 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.4rem;
    text-transform: none;
  }
  .posts h2 a {
    color: var(--red);
  }
  .posts p {
    margin: 0;
  }
</style>
