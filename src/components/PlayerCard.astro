---
import Placeholder from './Placeholder.astro';
const { player } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const initials = player.name
  .split(/\s+/)
  .map((w: string) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
<article class="player panel">
  <div class="player-photo">
    {player.photo ? (
      <img src={`${base}/images/team/${player.photo}`} alt={player.name} loading="lazy" />
    ) : (
      <Placeholder mark={initials} label="Photo coming soon" />
    )}
  </div>
  <div class="player-body">
    <h3>{player.name}</h3>
    {player.role && <p class="player-role">{player.role}</p>}
    <p>{player.bio}</p>
  </div>
</article>

<style>
  .player {
    display: flex;
    flex-direction: column;
  }
  .player-photo {
    aspect-ratio: 1;
    border-bottom: 3px solid var(--ink);
    overflow: hidden;
  }
  .player-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .player-body {
    padding: 1rem 1.1rem 1.2rem;
  }
  .player-body h3 {
    margin-bottom: 0.35rem;
    text-transform: none;
    overflow-wrap: anywhere;
  }
  .player-role {
    display: inline-block;
    background: var(--ink);
    color: var(--yellow);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    margin: 0 0 0.5rem;
  }
  .player-body p:last-child {
    margin: 0;
    font-size: 0.97rem;
  }
</style>
