---
const { title, description = "Team Tennent's: a Star Wars: Unlimited team of friends who play cards and compete." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} | Team Tennent's` : "Team Tennent's";
const nav = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/team/`, label: 'Meet the team' },
  { href: `${base}/accomplishments/`, label: 'Accomplishments' },
  { href: `${base}/blog/`, label: 'Blog' },
];
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === `${base}/` ? current === href : current.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6C101" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}/logo.jpg`, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Graduate&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={`${base}/`} aria-label="Team Tennent's home">
          <span class="brand-mark">TT</span>
          <span class="brand-name">Team Tennent's</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p><span class="brand-mark small">TT</span> Team Tennent's. Find us at the tournaments.</p>
        <p class="fine">
          A fan-made team site. Not affiliated with or endorsed by Tennent's, Fantasy Flight Games, or Lucasfilm.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --yellow: #f6c101;
    --red: #e31b23;
    --ink: #111;
    --paper: #fff8e1;
    --display: 'Graduate', 'Rockwell', 'Courier New', serif;
    --body: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --shadow: 6px 6px 0 var(--ink);
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    padding-block: 2.5rem 4rem;
  }
  .wrap {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    color: var(--red);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.6em;
    /* thin dark edge keeps red readable on yellow */
    text-shadow: 2px 2px 0 var(--ink);
  }
  h1 {
    font-size: clamp(2.2rem, 7vw, 4rem);
  }
  h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
  }
  h3 {
    font-size: 1.25rem;
    text-shadow: 1px 1px 0 var(--ink);
  }
  a {
    color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  a:hover {
    color: var(--red);
  }
  img {
    max-width: 100%;
    display: block;
  }
  .panel {
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: var(--shadow);
  }
  .panel h2,
  .panel h3 {
    text-shadow: none;
  }
  .button {
    display: inline-block;
    background: var(--red);
    color: #fff;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .button:hover {
    color: #fff;
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .lede {
    font-size: 1.2rem;
    max-width: 60ch;
  }
  .section {
    margin-top: 4rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head a {
    font-weight: 700;
  }

  .site-header {
    border-bottom: 3px solid var(--ink);
    background: var(--yellow);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .brand-mark {
    font-family: var(--display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--red);
    letter-spacing: -0.06em;
    text-shadow: 2px 2px 0 var(--ink);
    padding-right: 0.1em;
  }
  .brand-mark.small {
    font-size: 1.4rem;
    text-shadow: 1px 1px 0 var(--ink);
  }
  .brand-name {
    font-family: var(--display);
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--ink);
  }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 3px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--red);
  }

  .site-footer {
    background: var(--ink);
    color: var(--yellow);
    padding-block: 1.75rem;
  }
  .site-footer p {
    margin: 0;
    font-weight: 700;
  }
  .site-footer .fine {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 400;
    color: #cfc7a8;
  }
</style>
